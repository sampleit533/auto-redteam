<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>auto-redteam Report — Run {{ data.run_id }}</title>
<style>
  body { font-family: sans-serif; max-width: 960px; margin: 40px auto; color: #222; }
  h1 { color: #c0392b; }
  h2 { color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 6px; }
  h3 { color: #2c3e50; margin-top: 24px; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 24px; }
  th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
  th { background: #2c3e50; color: white; }
  tr:nth-child(even) { background: #f9f9f9; }
  .pass { color: #27ae60; font-weight: bold; }
  .fail { color: #e74c3c; font-weight: bold; }
  .skip { color: #7f8c8d; font-weight: bold; }
  .summary-box { background: #f0f4f8; border-left: 5px solid #2980b9; padding: 16px; margin-bottom: 24px; }
  .coverage-pct { font-size: 2em; font-weight: bold; color: {% if data.summary.overall_coverage_pct >= 80 %}#27ae60{% else %}#e74c3c{% endif %}; }
  code { background: #f8f9fb; padding: 1px 4px; border-radius: 4px; }
</style>
</head>
<body>

<h1>auto-redteam Detection Report</h1>
<p>Generated: {{ generated_at }} &nbsp;|&nbsp; Run ID: <code>{{ data.run_id }}</code></p>

<div class="summary-box">
  <strong>Overall Detection Coverage:</strong>
  <span class="coverage-pct">{{ data.summary.overall_coverage_pct }}%</span>
  &nbsp; ({{ data.summary.passed }} / {{ data.summary.total_detection_checks }} checks passed
  across {{ data.summary.scenarios_evaluated }} scenario(s))
</div>

{% for scenario in data.scenarios %}
<h2>{{ scenario.scenario_id }} &mdash; {{ scenario.mitre_ttp }}</h2>
<p>Coverage: <strong>{{ scenario.detection_coverage_pct }}%</strong>
   ({{ scenario.passed }} / {{ scenario.total }})</p>
<p>Scenario status: <strong>{{ scenario.status }}</strong></p>
<p>Simulation window: <code>{{ scenario.sim_start }}</code> → <code>{{ scenario.sim_end }}</code></p>

{% if scenario.details %}
<h3>Run Details</h3>
<table>
  <tr>
    <th>Field</th>
    <th>Value</th>
  </tr>
  {% for key, value in scenario.details.items() %}
  <tr>
    <td><code>{{ key }}</code></td>
    <td><code>{{ value }}</code></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<table>
  <tr>
    <th>Rule ID</th>
    <th>Description</th>
    <th>Hits</th>
    <th>Min Required</th>
    <th>Status</th>
  </tr>
  {% for det in scenario.detections %}
  <tr>
    <td><code>{{ det.rule_id }}</code></td>
    <td>{{ det.description }}</td>
    <td>{{ det.hit_count if det.hit_count is defined else "—" }}</td>
    <td>{{ det.min_hits if det.min_hits is defined else "composite" }}</td>
    <td class="{% if det.passed is none %}skip{% elif det.passed %}pass{% else %}fail{% endif %}">
      {% if det.passed is none %}SKIP{% elif det.passed %}PASS{% else %}FAIL{% endif %}
    </td>
  </tr>
  {% endfor %}
</table>

{% if scenario.event_sequence %}
<h3>Observed Event Sequence</h3>
<table>
  <tr>
    <th>Event</th>
    <th>Principal</th>
    <th>Resource</th>
    <th>Timestamp</th>
  </tr>
  {% for event in scenario.event_sequence %}
  <tr>
    <td><code>{{ event.event_name }}</code></td>
    <td><code>{{ event.principal or "—" }}</code></td>
    <td><code>{{ event.resource or "—" }}</code></td>
    <td><code>{{ event.event_time if event.event_time is not none else "—" }}</code></td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% endfor %}

<hr>
<p style="color:#999; font-size:0.85em;">
  All simulations are non-destructive and run in an isolated sandbox environment.
  This report is auto-generated by auto-redteam.
</p>
</body>
</html>
